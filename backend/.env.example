# ==============================================================================
# Qwenton CommerceOps — Vercel Backend Environment Variables
# Domain: https://qwen.qwenton.shop
# ==============================================================================

# Public Host URL
NEXT_PUBLIC_BASE_URL=https://qwen.qwenton.shop

# ------------------------------------------------------------------------------
# FamGateway Payment Gateway Integration
# ------------------------------------------------------------------------------
FAMGATEWAY_API_URL=https://api.famgateway.com/v1
FAMGATEWAY_MERCHANT_ID=FG_MERCHANT_SAMPLE
FAMGATEWAY_API_KEY=fg_live_sample_apikey_123456
FAMGATEWAY_SECRET=fg_secret_sample_abcdef
FAMGATEWAY_WEBHOOK_SECRET=fg_whsec_sample_987654321

# Webhook Callback URL registered with FamGateway Dashboard:
# https://qwen.qwenton.shop/api/webhook/famgateway

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Project: qwenton-reelmarket)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=qwenton-reelmarket
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@qwenton-reelmarket.iam.gserviceaccount.com
# Note: In Vercel, replace escaped newlines \n with actual newlines or keep as-is if using base64
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://qwenton-reelmarket-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=qwenton-reelmarket.firebasestorage.app
